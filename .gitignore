# What your runs create in this folder. None of it belongs in a commit.

# Your override file and replacement CSVs. The override file can hold the DSRM password in plain text.
/overrides/

# A build profile for one build.
include/build-profile.psd1

# Transcripts, run logs, and the dcdiag and repadmin reports.
/logs

# The users-<timestamp> files hold every generated password.
/artifacts
